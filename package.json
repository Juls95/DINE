{
  "name": "near-rdc",
  "version": "0.1.0",
  "private": true,
  "description": "NEAR Research Development Council: Beary (social), Bison (on-chain), Bul (thesis) — evidence-first investment thesis for NEAR.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mock": "tsx src/mock/run.ts",
    "bison:fetch": "tsx src/bison/run.ts",
    "beary:run": "tsx src/beary/run.ts",
    "beary:backfill": "tsx src/beary/run.ts --backfill-weeks 4",
    "bul:build": "tsx src/bul/build.ts && vite build",
    "refresh": "pnpm bison:fetch && pnpm beary:run && pnpm bul:build",
    "demo": "pnpm mock && DATA_MODE=mock pnpm bul:build",
    "verify": "tsx src/bul/verify.ts",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.5.0",
    "debug": "4.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/debug": "4.1.13",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-jest": "30.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
