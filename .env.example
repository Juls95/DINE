# Copy to .env (never committed). Everything is validated with zod in src/config/env.ts.

# mock | live. "mock" writes to data/mock/ and examples/; "live" writes to data/ and THESIS.md.
DATA_MODE=live

# Beary structuring LLM. Switching models is an env-var change.
LLM_PROVIDER=gemini
# Required for gemini: use the exact id of the current model from the Gemini documentation.
LLM_MODEL=
GEMINI_API_KEY=

# X search (Beary) with the xAI Responses API + x_search.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_MAX_TURNS=2

# Bison · BigQuery (minimum role: BigQuery Job User on your project).
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
BQ_MAX_BYTES=20000000000
BQ_WINDOW_DAYS=180

# Beary · Notion (internal integration token). Never commit it. On Render: a secret with sync:false.
# Create the integration at https://www.notion.so/my-integrations (Read content),
# share TickersInfo, X Creative Output and X Account Analyses with it, and paste the token.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
# Optional: override the IDs in config/beary.notion.yaml (they are not secrets).
# NOTION_DB_TICKERS_INFO=
# NOTION_DB_X_CREATIVE=
# NOTION_DB_X_ANALYSES=

# Bison · NEAR Intents Explorer API (JWT from the Partner Dashboard).
INTENTS_JWT=
# Verify against receipt_actions before the first real run.
INTENTS_CONTRACT=intents.near
INTENTS_WINDOW_DAYS=90

# Logs: rdc:* for everything, rdc:bison:* for one agent.
DEBUG=rdc:*
