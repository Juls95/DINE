# Copia a .env (nunca se commitea). Todo se valida con zod en src/config/env.ts.

# mock | live. "mock" escribe en data/mock/ y examples/; "live" escribe en data/ y THESIS.md.
DATA_MODE=live

# LLM de estructuración de Beary. Cambiar de modelo es un cambio de env var.
LLM_PROVIDER=gemini
# Requerido para gemini: usa el id exacto del modelo vigente según la documentación de Gemini.
LLM_MODEL=
GEMINI_API_KEY=

# Búsqueda en X (Beary) con xAI Responses API + x_search.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_MAX_TURNS=2

# Bison · BigQuery (rol mínimo: BigQuery Job User en tu proyecto).
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
BQ_MAX_BYTES=20000000000
BQ_WINDOW_DAYS=180

# Bison · NEAR Intents Explorer API (JWT del Partner Dashboard).
INTENTS_JWT=
# Verificar contra receipt_actions antes de la primera corrida real.
INTENTS_CONTRACT=intents.near
INTENTS_WINDOW_DAYS=90

# Logs: rdc:* para todo, rdc:bison:* para un agente.
DEBUG=rdc:*
